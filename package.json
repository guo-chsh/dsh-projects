{
  "name": "@guo-chsh/dsh-projects",
  "version": "0.1.6",
  "type": "module",
  "description": "Projects for DeepSeek Harness: group several physical folders into one project with a single primary workspace, browse them as a Projects tree in the left sidebar, and share one memory across the project's sessions.",
  "license": "MIT",
  "author": "Llane <cs.guo@outlook.com>",
  "homepage": "https://github.com/guo-chsh/dsh-projects#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guo-chsh/dsh-projects.git"
  },
  "bugs": {
    "url": "https://github.com/guo-chsh/dsh-projects/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cordis",
    "project",
    "workspace",
    "sidebar",
    "multi-root"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}